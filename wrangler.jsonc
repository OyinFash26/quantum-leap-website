// Cloudflare deploy settings: serve only the built website in site/ as static files.
{
  "name": "quantum-leap-website",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    // /about serves about.html, and /about.html redirects to /about (matches the site's canonical URLs)
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
